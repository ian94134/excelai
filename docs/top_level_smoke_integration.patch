diff --git a/.github/workflows/excel-com-smoke.yml b/.github/workflows/excel-com-smoke.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/excel-com-smoke.yml
@@ -0,0 +1,34 @@
+name: Excel COM Smoke
+
+on:
+  workflow_dispatch:
+    inputs:
+      runner:
+        description: Runner label. Use a self-hosted Windows runner with desktop Excel for real COM smoke.
+        required: false
+        default: windows-latest
+
+jobs:
+  excel-com-smoke:
+    runs-on: ${{ inputs.runner }}
+    defaults:
+      run:
+        working-directory: excel-ai
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: excel-ai/requirements-dev.txt
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements-dev.txt
+
+      - name: Run Excel COM smoke
+        env:
+          EXCEL_AI_RUN_COM_SMOKE: '1'
+        run: pytest -q tests/test_tool_smoke.py
